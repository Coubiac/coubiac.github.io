@startuml
title HAT et RAT - deux contrôles différents

skinparam shadowing false
skinparam linetype ortho
skinparam componentStyle rectangle
left to right direction

rectangle "Serveur SMTP distant\n203.0.113.25" as Sender

rectangle "Cisco Secure Email Gateway" {

    component "Public Listener" as Listener

    rectangle "HAT - Qui se connecte ?" as HAT {
        component "Critères Sender Group\nIP / réseau\nHostname / domaine\nDNS List\nOrganisation\nTalos / IP Reputation" as HATCRIT
        rectangle "Sender Group\nDans quelle catégorie ?" as SG
        rectangle "Mail Flow Policy\nComment traiter cette catégorie ?\n\nAction SMTP / limites / TLS\nActivation des contrôles de sécurité" as MFP

        HATCRIT --> SG : correspondance
        SG --> MFP : politique associée
    }

    rectangle "RCPT TO:<user@example.net>" as RCPT
    rectangle "RAT\nCette destination est-elle acceptée ?" as RAT
    rectangle "LDAP Recipient Acceptance\nCe destinataire existe-t-il ?\n(optionnel)" as LDAP
    component "DATA\nLe message peut être reçu" as ACCEPT
}

Sender --> Listener : Connexion SMTP
Listener --> SG : évaluation HAT
MFP --> RCPT : conversation SMTP
RCPT --> RAT
RAT --> ACCEPT : destination acceptée
RAT ..> LDAP : validation éventuelle
LDAP ..> ACCEPT : destinataire valide

note bottom of HAT
HAT = contrôle du serveur SMTP connecté.
Ce n'est pas le From: visible du message.
end note

note bottom of RAT
RAT = contrôle de la destination SMTP.
Ce n'est ni l'antispam ni l'antivirus.
end note

@enduml
