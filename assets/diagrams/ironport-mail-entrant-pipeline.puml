@startuml
title Parcours d'un mail entrant - Cisco Secure Email Gateway

skinparam shadowing false
skinparam linetype ortho
skinparam componentStyle rectangle
top to bottom direction

cloud "Internet" as Internet

rectangle "Cisco Secure Email Gateway / IronPort" {

    package "1. Receipt - Connexion et sélection de politique" {
        component "Public Listener\nSMTP" as Listener

        rectangle "HAT du Listener\nHost Access Table" as HAT {
            component "Critères des Sender Groups\n\nIP / réseau\nHostname / domaine\nDNS List\nOrganisation\nTalos / IP Reputation" as HATCRIT
            component "Sender Group\nClassification de l'hôte SMTP" as SG
            component "Mail Flow Policy\n\nACCEPT / REJECT / RELAY / TCPREFUSE\nRate limits / TLS / limites SMTP\nActivation des contrôles de sécurité" as MFP

            HATCRIT --> SG : correspondance
            SG --> MFP : politique associée
        }
    }

    package "2. Receipt - Conversation SMTP" {
        component "EHLO / HELO" as HELO
        component "MAIL FROM\nEnvelope sender / reverse-path" as MAILFROM
        component "RCPT TO\nEnvelope recipient" as RCPT
        component "RAT\nRecipient Access Table" as RAT
        component "LDAP Recipient Acceptance\n(optionnel)" as LDAP
        component "DATA\nHeaders + corps + pièces jointes" as DATA
        component "From:\nAuthor Domain visible" as FROMHDR

        package "Authentification du courrier" {
            component "SPF" as SPF
            component "DKIM" as DKIM
            component "DMARC" as DMARC
        }

        HELO --> MAILFROM
        MAILFROM --> RCPT
        RCPT --> RAT
        RAT --> DATA : destination acceptée

        RAT ..> LDAP : si configuré
        LDAP ..> DATA : destinataire valide

        MAILFROM ..> SPF : IP source + MAIL FROM
        HELO ..> SPF : notamment si reverse-path nul
        DATA ..> DKIM : signature + message
        DATA ..> FROMHDR
        SPF --> DMARC : résultat + domaine SPF
        DKIM --> DMARC : résultat + d=
        FROMHDR --> DMARC : domaine du From:
    }

    package "3. Work Queue" {
        component "Traitement du message\n\nMessage Filters / Mail Policies\nAnti-Spam / Anti-Virus\nFile Reputation / Analysis\nContent Filters / Outbreak Filters" as WQ
    }

    package "4. Delivery" {
        component "SMTP Routing" as ROUTING
    }
}

rectangle "Serveur de messagerie" {
    component "Exchange / MTA interne" as MAILSERVER
}

Internet --> Listener
Listener --> SG : évaluation du HAT
MFP --> HELO : session SMTP acceptée

MFP ..> SPF : active selon politique
MFP ..> DKIM : active selon politique
MFP ..> DMARC : active selon politique
MFP ..> WQ : marque pour scans\nAnti-Spam / Anti-Virus

DATA --> WQ : message accepté
WQ --> ROUTING
ROUTING --> MAILSERVER

note right of MFP
La Mail Flow Policy est choisie très tôt.
Elle décide quels contrôles seront appliqués,
mais ceux-ci ne sont exécutés que lorsque
les données nécessaires sont disponibles.
end note

note right of DMARC
DMARC ne compare pas des adresses complètes.
Il exige qu'au moins une identité SPF ou DKIM
valide soit alignée avec le domaine du From:.
end note

@enduml
